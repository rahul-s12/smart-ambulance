# Copy this file to .env and add your own MongoDB connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional: set only if the local DNS resolver rejects MongoDB SRV lookups.
MONGODB_DNS_SERVER=1.1.1.1
# Atlas works most reliably from this network over IPv4.
MONGODB_IP_FAMILY=4
MONGODB_DATABASE=smart_ambulance_test
PORT=3000
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_AMBULANCE_ID=SIM-AMB-001
